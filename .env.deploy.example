# Copy this file to .env.deploy.local and fill it in.
# .env.deploy.local is ignored by git — never commit real login details.

# FTP server and login: the same as FileZilla's Site Manager uses for tribeofabraham.com.
# Deploys use FTP with TLS encryption (FTPS), like FileZilla does.
DEPLOY_HOST=
DEPLOY_PORT=21
DEPLOY_USER=
DEPLOY_PASSWORD=

# The site's folder, as FileZilla shows it after you log in (it holds the site's index.html).
DEPLOY_PATH=

# Bluehost's FTP certificate is issued to *.bluehost.com, not the FTP hostname.
DEPLOY_CERT_NAME=bluehost.com
